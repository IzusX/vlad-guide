# Скопируйте в .env.local; все обязательные поля нужно заполнить.
# Формат: openai-chat | openai-responses | anthropic-messages
AI_API_FORMAT=openai-chat
# Полный endpoint, например https://openrouter.ai/api/v1/chat/completions
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Необязательные ограничения
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=600
# Для openai-chat: max_tokens или max_completion_tokens (согласно API провайдера)
AI_CHAT_TOKEN_PARAM=max_tokens
